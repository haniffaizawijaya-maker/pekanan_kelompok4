# Contoh environment produksi Sudoy. BUKAN file .env yang sebenarnya.
# Salin file ini menjadi .env DI SERVER, lalu isi semua nilai
# yang ditandai. Jangan pernah menempel kunci asli di file ini,
# di chat, atau di commit. Jangan pernah menyalin .env.example
# (konfigurasi development lokal) ke server production.
#
# APP_KEY diisi dengan hasil `php artisan key:generate` di server,
# bukan disalin dari mesin development.

APP_NAME=Sudoy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.example
# Ganti APP_URL dengan domain HTTPS sungguhan. Callback Tripay
# dan URL yang dihasilkan aplikasi memakai nilai ini.

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log harian agar file log tidak membesar tanpa batas.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL production. Isi kredensial database server sendiri.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sudoy
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true bila aplikasi berjalan di belakang HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mailer sungguhan WAJIB dikonfigurasi di production: email
# verifikasi dan reset kata sandi tidak terkirim bila mailer
# tetap log. Isi sesuai penyedia email yang dipakai.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Bila aplikasi berjalan di belakang reverse proxy atau load
# balancer (misalnya nginx), setel variabel ini sebagai variabel
# environment SERVER (bukan hanya di .env bila config di-cache)
# agar URL dan cookie membaca skema HTTPS dari header proxy.
# Nilai '*' berarti percaya pada IP pemanggil (proxy di depan
# server ini). Kosongkan bila aplikasi terekspos langsung.
TRUSTED_PROXIES=

# Tripay PRODUCTION. Kredensial production BERBEDA dari sandbox
# dan diambil dari dashboard Tripay production. Jangan isi
# kredensial sandbox di sini. Jangan kirim kunci lewat chat.
TRIPAY_MODE=production
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_QRIS_CHANNEL=QRIS2
TRIPAY_EXPIRED_HOURS=24
